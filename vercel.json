{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/agent/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth?authpath=$1" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known?as=1" },
    { "source": "/((?!api/|agent/|assets/|icons/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ]
}
