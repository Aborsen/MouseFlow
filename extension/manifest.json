{
  "manifest_version": 3,
  "name": "MouseFlow",
  "version": "0.1.0",
  "description": "Record clicks and typing in a page, replay them, and chain recordings into repeatable flows.",
  "minimum_chrome_version": "127",

  "permissions": ["scripting", "tabs", "storage"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "MouseFlow",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png",
      "128": "icons/icon-512.png"
    }
  },

  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-512.png"
  },

  "externally_connectable": {
    "matches": [
      "https://mouse-agent.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
