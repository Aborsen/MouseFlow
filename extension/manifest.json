{
  "manifest_version": 3,
  "name": "MouseFlow",
  "version": "0.4.2",
  "description": "Record a flow and repeat it, or describe what you need and have it done for you.",
  "minimum_chrome_version": "127",

  "permissions": ["scripting", "tabs", "storage", "webNavigation"],

  "host_permissions": ["<all_urls>", "https://api.anthropic.com/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "MouseFlow",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png",
      "128": "icons/icon-512.png"
    }
  },

  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-512.png"
  },

  "externally_connectable": {
    "matches": [
      "https://mouse-agent.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
