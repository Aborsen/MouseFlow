{
  "name": "@insightis/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"const fs=require('node:fs');for (const p of ['dist','.turbo','coverage','node_modules']){try{fs.rmSync(p,{recursive:true,force:true});}catch{}}\"",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "exports": {
    "./tailwind.config": "./tailwind.config.ts",
    "./globals.css": "./src/globals.css",
    "./cn": {
      "source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./use-mobile": {
      "source": "./src/hooks/use-mobile.tsx",
      "types": "./dist/hooks/use-mobile.d.ts",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./*": {
      "source": "./src/components/*/index.tsx",
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "devDependencies": {
    "@insightis/typescript-config": "workspace:*",
    "@insightis/unit-tests": "workspace:*",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.23",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-resizable-panels": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  }
}
