{
  "name": "mouseflow-web",
  "private": true,
  "type": "module",
  "description": "The MouseFlow app, on the Insightis frontend stack: React 19, Vite, Tailwind, TanStack Router, and the vendored subset of @insightis/ui it renders.",
  "scripts": {
    "prebuild": "node scripts/copy-agent.mjs",
    "predev": "node scripts/copy-agent.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:extension": "tsc --noEmit && vite build --config vite.extension.config.ts",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "dev:mock": "node scripts/copy-agent.mjs && node scripts/dev-mock.mjs",
    "sync:ui": "node scripts/sync-design-system.mjs",
    "sync:ui:check": "node scripts/sync-design-system.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-router": "^1.145.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@insightis/typescript-config": "file:vendor/insightis-typescript-config",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.7",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
